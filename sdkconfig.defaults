CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# The production badge server's device address (the parent repository's deploy/:
# a load balancer with Cloud Armor in front of Cloud Run service bp26-badges), so
# a freshly flashed badge talks to it without a console "server" command. Badges
# built before 0.5.8 have the old Cloud Run URL, which forwards here; a badge on
# the build default keeps its ID and secret across the change (NVS "cloud/server"
# stays empty). "server <url>" still overrides it; "server clear" comes back.
CONFIG_SOLANA_OS_SERVER_URL="https://badge-api.solana.com"

# App metadata shown in About / info
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.5.15"

# Over-the-air updates (core/os_ota.c): a new build boots on trial and the
# bootloader goes back to the previous slot unless it confirms itself. This
# lives in the bootloader, which OTA never rewrites: it takes a /stock flash.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# FAT long file names
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# RAM: there is no PSRAM and IRAM/DRAM share one SRAM. Keep driver code in
# flash so the heap is big enough for Wi-Fi, TLS and LVGL at once.
CONFIG_FREERTOS_IN_IRAM=n
CONFIG_RINGBUF_IN_IRAM=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# Wi-Fi: keep buffers modest
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

# RAM (0.5.13): IRAM and DRAM share the one SRAM, so code kept out of IRAM is
# heap. The ROM's esp_flash driver instead of ESP-IDF's (~9 KB; the ROM lacks
# only auto-suspend, unused here), and the SPI master ISR, the ring buffer's
# ISR functions (the UART ISR, their only user, is in flash as well), heap_caps,
# the libc locks and the I2C ISR in flash. None of it runs while the cache is
# off: an LCD flush or a button read that lands on a flash write finishes a
# few ms later.
CONFIG_SPI_FLASH_ROM_IMPL=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_LIBC_LOCKS_PLACE_IN_IRAM=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
# Nothing makes a FreeRTOS software timer (esp_timer does that work).
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=1536
# lwIP: the badge speaks IPv4 to one server (os_ws resolves AF_INET only), has
# no soft-AP, needs no loopback and never holds more than one socket; a closed
# connection's TIME_WAIT lasts 10 s instead of 2 min.
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DHCPS=n
CONFIG_LWIP_MAX_SOCKETS=4
CONFIG_LWIP_NETIF_LOOPBACK=n
CONFIG_LWIP_TCP_MSL=5000
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# No Bluetooth: badge radios are Wi-Fi and ESP-NOW. Keeping the BT stack out
# of the image frees its controller RAM for the UI and TLS.
CONFIG_BT_ENABLED=n

# LVGL
# LVGL allocates from the system heap so Wi-Fi and the UI share RAM
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_USE_SNAPSHOT=n
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_QRCODE=y

# TLS for the badge server (core/os_http.c): allocate the record buffers per
# message and free the handshake data after use. A handshake costs ~47 KB of
# heap with static 16 KB/4 KB buffers.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# os_http keeps one connection to the server open: drop the server's
# certificate after the handshake (~4 KB held otherwise), and keep a session
# ticket so the handshake after an idle close is a short resumption.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
# Google's front end (the server, Cloud Run) sends GTS Root R1 cross-signed by
# GlobalSign Root CA, which ESP-IDF 6's bundle no longer has: verify the chain
# through the bundle's own GTS Root R1 instead (~700 B of heap).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# The handshake's TX buffer is this big; the client's largest message is a
# ClientHello under 1 KB. Application data is written per record, and
# esp_http_client and os_ws both loop on partial writes.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# Mesh messages are untrusted JSON and cJSON parses recursively (~80 B of
# stack per level): cap the depth so a crafted frame can't overflow a task.
# os_mesh also drops anything nested deeper than 8 before parsing.
CONFIG_CJSON_NESTING_LIMIT=16
